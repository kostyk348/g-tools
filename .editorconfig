# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C++: 4 пробела (в коде табов нет)
[*.{h,hpp,cpp,cc,cxx}]
indent_style = space
indent_size = 4

# CMake и YAML: 2 пробела
[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Python: PEP 8
[*.py]
indent_size = 4

# Markdown: концевые пробелы значимы (hard line break)
[*.md]
trim_trailing_whitespace = false

[*.sh]
indent_size = 2
